# BlindPaper Backend Environment Configuration
# Copy this file to ".env" and fill in the values. ".env" is private and is never committed.

# Application Settings
APP_NAME=BlindPaper
ENVIRONMENT=development
DEBUG=True

# Allowed CORS origins for the frontend (comma-separated). Open the app at either address.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB (local instance)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=blindpaper

# Login sessions last this many hours
SESSION_TTL_HOURS=168

# The administrator account. It is created when the backend starts if it does not exist yet.
# The admin panel only opens with these credentials: choose your own and keep the password private.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@blindpaper.com
ADMIN_PASSWORD=change-this-password

# Question generation with Groq. Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tried automatically if the main model is busy or gives an unusable answer
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
