# BlindPaper Backend Environment Configuration

# Application Settings
APP_NAME=BlindPaper
ENVIRONMENT=development
DEBUG=True

# Allowed CORS Origins (comma-separated or single URL)
ALLOWED_ORIGINS=http://localhost:5173

# AI Question Generation Settings (Optional - demo fallback used if omitted)
# LLM_PROVIDER=gemini # or openai
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gemini-1.5-flash

# MongoDB Database Configuration (Local instance)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=blindpaper
